{
  servers {
    protocols h1 h2 h3
  }
}

localhost, 127.0.0.1 {
  # Security Headers
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ws: wss: http: https: blob:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none';"
    -Server
  }

  # Compress responses
  encode zstd gzip

  # API Endpoints
  handle /api/* {
    reverse_proxy server:8080 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # WebSocket Relay
  handle /ws {
    reverse_proxy server:8080 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Encrypted Media Blobs
  handle /media/* {
    reverse_proxy server:8080 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Frontend Web App & PWA Assets
  handle {
    reverse_proxy web:5173 {
      header_up Host {host}
      header_up Upgrade {>Upgrade}
      header_up Connection {>Connection}
    }
  }
}
