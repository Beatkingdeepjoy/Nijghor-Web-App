# Nijghor Environment Configuration
ENVIRONMENT=development
PORT=8080
APP_BASE_URL=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgres://nijghor_user:nijghor_secret_pwd@localhost:5432/nijghor_db?sslmode=disable

# Cache & Ephemeral Queue (Redis 7)
REDIS_URL=redis://:nijghor_redis_pwd@localhost:6379/0

# Encrypted Media Storage (MinIO / S3 / Cloudflare R2)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nijghor_minio_admin
MINIO_SECRET_KEY=nijghor_minio_secret_pwd
MINIO_BUCKET=nijghor-media
MINIO_USE_SSL=false

# Authentication Secrets (Must be 32+ bytes cryptographic random strings)
JWT_ACCESS_SECRET=nijghor_super_secure_jwt_access_secret_change_in_prod_32b!
JWT_REFRESH_SECRET=nijghor_super_secure_jwt_refresh_secret_change_in_prod_32b!

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nijghor.internal

# Email Provider Configuration ("mock", "smtp", or "resend")
EMAIL_PROVIDER=mock
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nijghor <no-reply@nijghor.internal>

# WebAuthn Relying Party Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=Nijghor
WEBAUTHN_RP_ORIGIN=http://localhost:5173
